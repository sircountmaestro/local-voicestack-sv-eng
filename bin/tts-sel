#!/usr/bin/env bash
# Läs markerad text och spela via Kokoro (en) eller Azure (sv).
set -u
export DISPLAY="${DISPLAY:-:0}"
export PATH="$HOME/.local/bin:/usr/bin:/bin:$PATH"

rundir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/local-voicestack"
mkdir -p "$rundir"
log="$rundir/tts-sel.log"
pidfile="$rundir/tts-sel.pid"
echo "$(date -Iseconds) start args=$* DISPLAY=$DISPLAY WAYLAND=${WAYLAND_DISPLAY:-}" >>"$log"

lang="${1:-en}"
case "$lang" in
  en|english|kokoro)
    url="http://127.0.0.1:8880/v1/audio/speech"
    health="http://127.0.0.1:8880/health"
    voice="af_heart"
    model="kokoro"
    max_chars=8000
    label="Kokoro EN"
    ;;
  sv|svenska|azure)
    url="http://127.0.0.1:5050/v1/audio/speech"
    health="http://127.0.0.1:5050/health"
    voice="sv-SE-HilleviNeural"
    model="azure-tts"
    max_chars=4000
    label="Azure SV"
    ;;
  *)
    command -v notify-send >/dev/null && notify-send "TTS" "Använd: tts-sel en  eller  tts-sel sv"
    echo "bad lang $lang" >>"$log"
    exit 2
    ;;
esac

if ! curl -sf --max-time 2 "$health" >/dev/null; then
  command -v notify-send >/dev/null && notify-send "TTS" "$label är nere. Kör: tts"
  echo "health fail $health" >>"$log"
  exit 1
fi

command -v notify-send >/dev/null && notify-send -t 2000 "TTS" "$label: läser markerad text"

read_sel() {
  local t=""
  if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    t="$(timeout 1 wl-paste --primary 2>/dev/null || true)"
    [[ -z "$t" ]] && t="$(timeout 1 wl-paste -n 2>/dev/null || true)"
  fi
  if [[ -z "$t" ]]; then
    t="$(timeout 2 python3 - <<'PY' 2>/dev/null || true
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk
for sel in (Gdk.SELECTION_PRIMARY, Gdk.SELECTION_CLIPBOARD):
    text = Gtk.Clipboard.get(sel).wait_for_text()
    if text and text.strip():
        print(text, end="")
        break
PY
)"
  fi
  printf '%s' "$t"
}
text="$(read_sel)"
if [[ -z "$text" ]]; then
  xclip="$(command -v xclip || true)"
  if [[ -n "$xclip" ]]; then
    text="$(timeout 1 "$xclip" -selection primary -o 2>/dev/null || true)"
    [[ -z "$text" ]] && text="$(timeout 1 "$xclip" -selection clipboard -o 2>/dev/null || true)"
  fi
fi
text="${text#"${text%%[![:space:]]*}"}"
text="${text%"${text##*[![:space:]]}"}"

if [[ -z "$text" ]]; then
  command -v notify-send >/dev/null && notify-send "TTS" "Ingen text markerad."
  echo "empty selection" >>"$log"
  exit 1
fi

echo "got ${#text} chars lang=$lang" >>"$log"

if (( ${#text} > max_chars )); then
  text="${text:0:max_chars}"
  command -v notify-send >/dev/null && notify-send "TTS" "Texten kapades till ${max_chars} tecken."
fi

out="$(mktemp "$rundir/tts-sel.XXXXXX.mp3")"
json="$(mktemp "$rundir/tts-sel.XXXXXX.json")"
cleanup() { rm -f "$out" "$json"; }
trap cleanup EXIT

export TTS_SEL_MODEL="$model"
export TTS_SEL_VOICE="$voice"
printf '%s' "$text" | python3 -c 'import json,os,sys; print(json.dumps({"model":os.environ["TTS_SEL_MODEL"],"voice":os.environ["TTS_SEL_VOICE"],"input":sys.stdin.read(),"response_format":"mp3"}))' >"$json"

if [[ -f "$pidfile" ]]; then
  oldpid="$(cat "$pidfile" 2>/dev/null || true)"
  if [[ -n "$oldpid" ]] && kill -0 "$oldpid" 2>/dev/null; then
    kill "$oldpid" 2>/dev/null || true
    wait "$oldpid" 2>/dev/null || true
  fi
  rm -f "$pidfile"
fi

code="$(curl -sS --max-time 120 -o "$out" -w '%{http_code}' \
  -H 'Content-Type: application/json' \
  --data-binary @"$json" \
  "$url")"

echo "http $code bytes $(wc -c < "$out" 2>/dev/null || echo 0)" >>"$log"

if [[ "$code" != "200" ]] || [[ ! -s "$out" ]]; then
  command -v notify-send >/dev/null && notify-send "TTS" "$label fel HTTP $code"
  exit 1
fi

player="$(command -v ffplay || command -v paplay || command -v pw-play || true)"
if [[ -z "$player" ]]; then
  echo "ingen spelare (ffplay/paplay)" >>"$log"
  exit 1
fi
if [[ "$(basename "$player")" == "ffplay" ]]; then
  "$player" -nodisp -autoexit -loglevel error "$out" &
else
  "$player" "$out" &
fi
echo $! >"$pidfile"
wait "$(cat "$pidfile")" 2>/dev/null || true
rm -f "$pidfile"
