#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=root.sh
source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/root.sh"

"$ROOT/apps/stt-hotkey/scripts/stt-stop" || true
docker compose -f "$ROOT/apps/kokoro-fastapi/compose.yml" down 2>/dev/null || true
docker compose -f "$ROOT/apps/kokoro-fastapi/compose.cpu.yml" down 2>/dev/null || true
docker compose -f "$ROOT/apps/azure-speech-gateway/compose.yml" down 2>/dev/null || true
docker compose -f "$ROOT/apps/whisper-stt-sv/compose.yml" down 2>/dev/null || true
echo "TTS avstängd (Kokoro :8880, Azure :5050, STT Ctrl+Alt+A)."
