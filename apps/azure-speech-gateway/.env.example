# Kopiera till .env på *den här* datorn. Ingen nyckel medföljer repot.
# Azure Portal → Speech-resurs → Nycklar. Committa aldrig .env.

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral

# Valfritt. Tom = regional TTS/STT.
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_STT_ENDPOINT=

AZURE_SPEECH_VOICE=sv-SE-HilleviNeural
AZURE_SPEECH_LANGUAGE=sv-SE
AZURE_SPEECH_FORMAT=audio-24khz-48kbitrate-mono-mp3
AZURE_SPEECH_STT_API_VERSION=2024-11-15
